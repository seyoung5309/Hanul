# 이 파일을 .env.local로 복사해서 값을 채운다. (.env.local은 git에 올리지 않음)
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hanul
# AWS RDS 연결 시 rds, 로컬 DB는 비워둔다.
DB_SSL=rds

# 충분히 긴 랜덤 문자열. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
