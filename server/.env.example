# 이 파일을 .env.local로 복사해서 값을 채운다. (.env.local은 git에 올리지 않음)
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hanul
# AWS RDS 연결 시 rds, 로컬 DB는 비워둔다.
DB_SSL=rds

# 충분히 긴 랜덤 문자열. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# 메일 속 링크의 주소 (배포 시 실제 도메인)
APP_URL=http://localhost:3000

# 비밀번호 재설정 메일. 비워두면 메일 대신 서버 콘솔에 링크가 출력된다.
# Gmail 예시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS=앱 비밀번호
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# AI 도우미 (Google Gemini). 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 무료 등급에서 안정적인 가벼운 모델. 더 좋은 모델(예: gemini-3.8-flash)은 붐비면 503이 잦음
GEMINI_MODEL=gemini-3.1-flash-lite
AI_DAILY_LIMIT=20
# 전체 사용자 월 토큰 상한. 0이면 제한 없음
AI_MONTHLY_TOKEN_LIMIT=0
